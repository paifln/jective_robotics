# Include inside the nginx http context. Replace hostname/certificate paths.
limit_req_zone $binary_remote_addr zone=jective_rate:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=jective_connections:10m;
server {
    listen 443 ssl;
    server_name assistant.example.invalid;
    ssl_certificate /etc/letsencrypt/live/assistant.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/assistant.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 200000;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 10s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    # No request bodies, authorization headers or upstream answers in proxy logs.
    access_log off;
    location = /chat/completions {
        limit_req zone=jective_rate burst=5 nodelay;
        limit_req_status 429;
        limit_conn jective_connections 5;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 45s;
        proxy_send_timeout 10s;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_next_upstream off;
    }
    location / { return 404; }
}
