# Server only; paths must be absolute. Never put this file in a student installer.
ASSISTANT_SECRET_FILE=/etc/jective-assistant/provider.secret.json
ASSISTANT_CREDENTIALS_FILE=/etc/jective-assistant/assistant-credentials.json
ASSISTANT_QUOTA_FILE=/var/lib/jective-assistant/quota.sqlite
# Set an available model from your OpenAI project before starting.
ASSISTANT_MODEL=
PORT=8787
ASSISTANT_DAILY_LIMIT=30
ASSISTANT_GLOBAL_DAILY_LIMIT=1000
ASSISTANT_CONCURRENCY=4
# The systemd template supplies ASSISTANT_MASTER_KEY_FILE through LoadCredential.
# For manual startup set either an absolute master-key file or ASSISTANT_MASTER_KEY.
